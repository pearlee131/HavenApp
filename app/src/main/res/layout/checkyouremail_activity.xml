<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/plain_bg">


    <!-- CENTER CONTENT -->

    <androidx.constraintlayout.widget.ConstraintLayout

        android:id="@+id/emailContainer"

        android:layout_width="0dp"

        android:layout_height="wrap_content"

        android:paddingStart="24dp"
        android:paddingEnd="24dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintVertical_bias="0.32">


        <!-- IMAGE -->

        <ImageView

            android:id="@+id/imgCheckEmail"

            android:layout_width="0dp"

            android:layout_height="0dp"

            android:scaleType="fitCenter"

            android:src="@drawable/check_email"

            app:layout_constraintWidth_percent="0.42"

            app:layout_constraintDimensionRatio="1:1"

            app:layout_constraintTop_toTopOf="parent"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent"/>



        <!-- TITLE -->

        <TextView

            android:id="@+id/txtTitle"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:fontFamily="@font/poppins_bold"

            android:text="Check Your Email"

            android:textColor="@android:color/black"

            android:textSize="28sp"

            app:layout_constraintTop_toBottomOf="@id/imgCheckEmail"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent"/>



        <!-- SUBTITLE -->

        <TextView

            android:id="@+id/txtSubtitle"

            android:layout_width="0dp"

            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:fontFamily="@font/poppins_regular"

            android:gravity="center"

            android:text="A verification OTP was sent to your registered email. Enter the code below to continue."

            android:textAlignment="center"

            android:textColor="#666666"

            android:textSize="14sp"

            app:layout_constraintTop_toBottomOf="@id/txtTitle"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent"/>



        <!-- OTP BOXES -->

        <LinearLayout

            android:id="@+id/otpContainer"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="28dp"

            android:orientation="horizontal"

            android:gravity="center"

            app:layout_constraintTop_toBottomOf="@id/txtSubtitle"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent">


            <EditText
                android:id="@+id/otp1"
                android:layout_width="42dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:background="@drawable/otp_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="20sp"/>


            <EditText
                android:id="@+id/otp2"
                android:layout_width="42dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:background="@drawable/otp_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="20sp"/>


            <EditText
                android:id="@+id/otp3"
                android:layout_width="42dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:background="@drawable/otp_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="20sp"/>


            <EditText
                android:id="@+id/otp4"
                android:layout_width="42dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:background="@drawable/otp_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="20sp"/>


            <EditText
                android:id="@+id/otp5"
                android:layout_width="42dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:background="@drawable/otp_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="20sp"/>


            <EditText
                android:id="@+id/otp6"
                android:layout_width="42dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:background="@drawable/otp_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="20sp"/>


        </LinearLayout>



        <!-- ERROR MESSAGE -->

        <TextView

            android:id="@+id/txtOtpError"

            android:layout_width="0dp"

            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:fontFamily="@font/poppins_regular"

            android:gravity="center"

            android:textColor="#FF2B35"

            android:textSize="13sp"

            android:visibility="gone"

            app:layout_constraintTop_toBottomOf="@id/otpContainer"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent"/>



        <!-- VERIFY BUTTON -->

        <com.google.android.material.button.MaterialButton

            android:id="@+id/btnVerify"

            android:layout_width="0dp"

            android:layout_height="56dp"

            android:layout_marginTop="8dp"

            android:fontFamily="@font/poppins_bold"

            android:text="Verify"

            android:textAllCaps="false"

            android:textColor="@android:color/white"

            android:textSize="18sp"

            app:backgroundTint="@color/violet"

            app:cornerRadius="12dp"

            app:layout_constraintTop_toBottomOf="@id/txtOtpError"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent"/>



        <!-- RESEND -->

        <LinearLayout

            android:id="@+id/layoutResend"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="14dp"

            android:orientation="horizontal"

            android:gravity="center"

            app:layout_constraintTop_toBottomOf="@id/btnVerify"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent">


            <TextView

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="Didn't get any code? "

                android:textColor="#666666"

                android:textSize="14sp"/>


            <TextView

                android:id="@+id/txtResend"

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:fontFamily="@font/poppins_bold"

                android:text="Click to resend"

                android:textColor="@color/violet"

                android:textSize="14sp"/>


        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>



    <!-- PROGRESS INDICATOR -->

    <LinearLayout

        android:id="@+id/progressLayout"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:orientation="horizontal"

        android:gravity="center"

        android:layout_marginBottom="32dp"

        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent">


        <View
            android:layout_width="26dp"
            android:layout_height="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/progress_active"/>


        <View
            android:layout_width="26dp"
            android:layout_height="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/progress_active"/>


        <View
            android:layout_width="26dp"
            android:layout_height="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/progress_inactive"/>


        <View
            android:layout_width="26dp"
            android:layout_height="6dp"
            android:background="@drawable/progress_inactive"/>


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>