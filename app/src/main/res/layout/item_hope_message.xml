<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="top"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">


    <!-- ===================================================== -->
    <!-- HOPE AVATAR -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHopeMessageAvatar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="2dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="17dp"
        app:cardElevation="1dp"
        app:strokeColor="#E6DFF3"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/imgHopeMessageAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="5dp"
            android:contentDescription="Hope"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chatbot" />

    </com.google.android.material.card.MaterialCardView>


    <!-- ===================================================== -->
    <!-- HOPE MESSAGE AREA -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="48dp"
        android:layout_weight="1"
        android:orientation="vertical">


        <!-- ================================================= -->
        <!-- NAME -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtHopeMessageName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginBottom="3dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Hope"
            android:textColor="#6C2BD9"
            android:textSize="10sp" />


        <!-- ================================================= -->
        <!-- MESSAGE BUBBLE -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHopeMessageBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="#EEE8F7"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="60dp"
                android:maxWidth="290dp"
                android:orientation="vertical"
                android:paddingStart="13dp"
                android:paddingTop="11dp"
                android:paddingEnd="13dp"
                android:paddingBottom="11dp">


                <!-- ========================================= -->
                <!-- MAIN ANSWER -->
                <!-- ========================================= -->

                <TextView
                    android:id="@+id/txtHopeMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#17113F"
                    android:textSize="12sp" />


                <!-- ========================================= -->
                <!-- ACTION BUTTON -->
                <!--
                     Examples:
                     Read More
                     View Hotlines
                     File a Report
                     View Emergency Options

                     Hidden unless needed.
                -->
                <!-- ========================================= -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHopeAction"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Read More"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:visibility="gone"
                    app:backgroundTint="#6C2BD9"
                    app:cornerRadius="12dp"
                    app:elevation="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />


                <!-- ========================================= -->
                <!-- SOURCE AREA -->
                <!-- Hidden unless source exists -->
                <!-- ========================================= -->

                <LinearLayout
                    android:id="@+id/layoutHopeSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="8dp"
                        android:background="#EEE8F7" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Source"
                        android:textColor="#6C2BD9"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/txtHopeSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="1dp"
                        android:textColor="#716A82"
                        android:textSize="9sp" />

                </LinearLayout>


                <!-- ========================================= -->
                <!-- RELATED QUESTIONS -->
                <!-- Hidden unless related questions exist -->
                <!-- ========================================= -->

                <LinearLayout
                    android:id="@+id/layoutHopeRelated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="You may also ask"
                        android:textColor="#6C2BD9"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/txtHopeRelated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#716A82"
                        android:textSize="9sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>