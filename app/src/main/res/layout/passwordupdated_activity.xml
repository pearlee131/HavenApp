<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/plain_bg">


    <!-- IMAGE -->

    <ImageView

        android:id="@+id/imgSuccess"

        android:layout_width="@dimen/auth_image_size"

        android:layout_height="@dimen/auth_image_size"

        android:scaleType="fitCenter"

        android:src="@drawable/forgot_password"


        app:layout_constraintTop_toTopOf="parent"

        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintVertical_bias="0.25"/>




    <!-- TITLE -->

    <TextView

        android:id="@+id/txtTitle"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:layout_marginTop="@dimen/space_medium"

        android:fontFamily="@font/poppins_bold"

        android:text="Password Updated"

        android:textColor="@android:color/black"

        android:textSize="@dimen/title_text_size"


        app:layout_constraintTop_toBottomOf="@id/imgSuccess"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"/>





    <!-- SUBTITLE -->


    <TextView

        android:id="@+id/txtSubtitle"

        android:layout_width="0dp"

        android:layout_height="wrap_content"

        android:layout_marginStart="@dimen/container_padding"

        android:layout_marginEnd="@dimen/container_padding"

        android:layout_marginTop="@dimen/space_small"

        android:fontFamily="@font/poppins_regular"

        android:gravity="center"

        android:text="You've successfully created a new password. Click below to log in."

        android:textAlignment="center"

        android:textColor="#666666"

        android:textSize="@dimen/subtitle_text_size"


        app:layout_constraintTop_toBottomOf="@id/txtTitle"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"/>





    <!-- BUTTON -->


    <com.google.android.material.button.MaterialButton

        android:id="@+id/btnBackToLogin"

        android:layout_width="0dp"

        android:layout_height="@dimen/button_height"

        android:layout_marginTop="@dimen/space_xlarge"

        android:layout_marginStart="@dimen/container_padding"

        android:layout_marginEnd="@dimen/container_padding"

        android:fontFamily="@font/poppins_bold"

        android:text="Back to Log In"

        android:textAllCaps="false"

        android:textColor="@android:color/white"

        android:textSize="@dimen/button_text_size"


        app:backgroundTint="@color/violet"

        app:cornerRadius="@dimen/corner_radius"


        app:layout_constraintTop_toBottomOf="@id/txtSubtitle"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"/>





    <!-- PROGRESS -->


    <LinearLayout

        android:id="@+id/progressLayout"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:orientation="horizontal"

        android:gravity="center"

        android:layout_marginBottom="@dimen/space_xlarge"


        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent">


        <View

            android:layout_width="@dimen/progress_width"

            android:layout_height="@dimen/progress_height"

            android:layout_marginEnd="@dimen/space_small"

            android:background="@drawable/progress_active"/>


        <View

            android:layout_width="@dimen/progress_width"

            android:layout_height="@dimen/progress_height"

            android:layout_marginEnd="@dimen/space_small"

            android:background="@drawable/progress_active"/>


        <View

            android:layout_width="@dimen/progress_width"

            android:layout_height="@dimen/progress_height"

            android:layout_marginEnd="@dimen/space_small"

            android:background="@drawable/progress_active"/>


        <View

            android:layout_width="@dimen/progress_width"

            android:layout_height="@dimen/progress_height"

            android:background="@drawable/progress_active"/>


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>