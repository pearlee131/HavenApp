<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F6FF">


    <!-- ================================================= -->
    <!-- FIXED EXPLORE HEADER -->
    <!-- ================================================= -->

    <RelativeLayout
        android:id="@+id/exploreHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/support_horizontal_padding"
        android:layout_marginTop="@dimen/support_top_padding"
        android:layout_marginEnd="@dimen/support_horizontal_padding"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/support_header_text_end_margin"
            android:orientation="vertical">

            <TextView
                android:id="@+id/exploreTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:text="Explore"
                android:textColor="#32118F"
                android:textSize="@dimen/support_title_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/exploreSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/support_subtitle_line_spacing"
                android:text="Discover helpful resources and updates to stay informed and supported."
                android:textColor="#504467"
                android:textSize="@dimen/support_subtitle_size" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/exploreNotificationContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/support_notification_margin_top"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/notificationBell"
                android:layout_width="@dimen/support_notification_size"
                android:layout_height="@dimen/support_notification_size"
                android:clickable="true"
                android:contentDescription="Notifications"
                android:focusable="true"
                android:scaleType="centerInside"
                android:src="@drawable/ic_notification" />

            <TextView
                android:id="@+id/txtExploreNotificationBadge"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_notification_badge"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="18dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:visibility="gone" />

        </FrameLayout>

    </RelativeLayout>


    <!-- ================================================= -->
    <!-- MAIN SCROLL CONTENT -->
    <!-- Starts with Latest Announcements -->
    <!-- ================================================= -->

    <ScrollView
        android:id="@+id/exploreScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/exploreHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomNavbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="18dp">


            <!-- ================================================= -->
            <!-- LATEST ANNOUNCEMENTS TITLE -->
            <!-- FIRST SCROLLABLE SECTION -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/support_horizontal_padding"
                android:layout_marginEnd="@dimen/support_horizontal_padding"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:text="Latest Announcements"
                    android:textColor="#17113F"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- DYNAMIC ANNOUNCEMENTS -->
            <!-- ================================================= -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerAnnouncements"
                android:layout_width="match_parent"
                android:layout_height="202dp"
                android:layout_marginTop="0dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/support_horizontal_padding"
                android:paddingTop="4dp"
                android:paddingEnd="@dimen/support_horizontal_padding"
                android:paddingBottom="8dp"
                android:scrollbars="none" />


            <!-- ================================================= -->
            <!-- INFORMATION HUB -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/support_horizontal_padding"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="@dimen/support_horizontal_padding"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:text="Information Hub"
                    android:textColor="#17113F"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <!-- ================================================= -->
                <!-- INFORMATION HUB ICONS -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:baselineAligned="false"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center"
                    android:orientation="horizontal">


                    <!-- LEGAL RIGHTS -->

                    <ImageView
                        android:id="@+id/cardLegalRights"
                        android:layout_width="0dp"
                        android:layout_height="105dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:contentDescription="Legal Rights"
                        android:focusable="true"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_legalrights" />


                    <!-- EDUCATIONAL ARTICLES -->

                    <ImageView
                        android:id="@+id/cardEducationalArticles"
                        android:layout_width="0dp"
                        android:layout_height="105dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:contentDescription="Educational Articles"
                        android:focusable="true"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_articles" />


                    <!-- EMERGENCY HOTLINES -->

                    <ImageView
                        android:id="@+id/cardEmergencyHotlines"
                        android:layout_width="0dp"
                        android:layout_height="105dp"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:contentDescription="Emergency Hotlines"
                        android:focusable="true"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_hotlines" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- TINIG NG KABABAIHAN -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">


                <!-- ================================================= -->
                <!-- TNK SECTION HEADER -->
                <!-- ================================================= -->

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/support_horizontal_padding"
                    android:layout_marginEnd="@dimen/support_horizontal_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:text="Tinig ng Kababaihan"
                        android:textColor="#17113F"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSeeAllEpisodes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/poppins_semibold"
                        android:padding="4dp"
                        android:text="See All"
                        android:textColor="#6C2BD9"
                        android:textSize="12sp" />

                </RelativeLayout>


                <!-- ================================================= -->
                <!-- TNK EPISODES -->
                <!-- ================================================= -->

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerTinigEpisodes"
                    android:layout_width="match_parent"
                    android:layout_height="202dp"
                    android:layout_marginTop="6dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingStart="@dimen/support_horizontal_padding"
                    android:paddingTop="4dp"
                    android:paddingEnd="@dimen/support_horizontal_padding"
                    android:paddingBottom="8dp"
                    android:scrollbars="none" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- BOTTOM CONTENT SPACE -->
            <!-- ================================================= -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

        </LinearLayout>

    </ScrollView>


    <!-- ================================================= -->
    <!-- FLOATING / MOVABLE HOPE ASSISTANT -->
    <!-- ================================================= -->

    <ImageView
        android:id="@+id/cardHopeAssistant"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:background="@null"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Open Hope Assistant"
        android:elevation="12dp"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chatbot"
        app:layout_constraintBottom_toTopOf="@id/bottomNavbar"
        app:layout_constraintEnd_toEndOf="parent" />
    <!-- ================================================= -->
    <!-- FIXED BOTTOM NAVIGATION -->
    <!-- ================================================= -->

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/navbar_height"
        android:layout_marginStart="@dimen/navbar_margin_horizontal"
        android:layout_marginEnd="@dimen/navbar_margin_horizontal"
        android:layout_marginBottom="@dimen/navbar_margin_bottom"
        android:backgroundTint="#F0E8FF"
        app:cardCornerRadius="35dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">


            <!-- HOME -->

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/homeIcon"
                    android:layout_width="@dimen/navbar_icon_size"
                    android:layout_height="@dimen/navbar_icon_size"
                    android:contentDescription="Home"
                    android:src="@drawable/home_button" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/navbar_text_margin_top"
                    android:text="Home"
                    android:textColor="#777777"
                    android:textSize="@dimen/navbar_text_size" />

            </LinearLayout>


            <!-- SUPPORT -->

            <LinearLayout
                android:id="@+id/navSupport"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/navbar_icon_size"
                    android:layout_height="@dimen/navbar_icon_size"
                    android:contentDescription="Support"
                    android:src="@drawable/support_button" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/navbar_text_margin_top"
                    android:text="Support"
                    android:textColor="#777777"
                    android:textSize="@dimen/navbar_text_size" />

            </LinearLayout>


            <!-- EXPLORE -->

            <LinearLayout
                android:id="@+id/navExplore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/navbar_icon_size"
                    android:layout_height="@dimen/navbar_icon_size"
                    android:contentDescription="Explore"
                    android:src="@drawable/explore_button" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/navbar_text_margin_top"
                    android:text="Explore"
                    android:textColor="#6C2BD9"
                    android:textSize="@dimen/navbar_text_size"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- PROFILE -->

            <LinearLayout
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/navbar_icon_size"
                    android:layout_height="@dimen/navbar_icon_size"
                    android:contentDescription="Profile"
                    android:src="@drawable/profile_button" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/navbar_text_margin_top"
                    android:text="Profile"
                    android:textColor="#777777"
                    android:textSize="@dimen/navbar_text_size" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
