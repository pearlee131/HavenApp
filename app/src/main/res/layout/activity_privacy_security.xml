<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F6FF">


    <!-- ===================================================== -->
    <!-- PURPLE ROUNDED HEADER -->
    <!-- SAME STYLE AS LEGAL RIGHTS -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/privacyHeader"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="38dp"
        android:layout_marginEnd="18dp"
        app:cardBackgroundColor="#4a2297"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="18dp"
            android:paddingEnd="12dp">


            <!-- HEADER TITLE -->

            <TextView
                android:id="@+id/txtPrivacyTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:text="Privacy &amp; Security"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/txtPrivacySubtitle"
                app:layout_constraintEnd_toStartOf="@id/btnPrivacyExit"
                app:layout_constraintVertical_chainStyle="packed" />


            <!-- HEADER SUBTITLE -->

            <TextView
                android:id="@+id/txtPrivacySubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Manage your privacy and data."
                android:textColor="#E9DFFF"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="@id/txtPrivacyTitle"
                app:layout_constraintTop_toBottomOf="@id/txtPrivacyTitle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnPrivacyExit" />


            <!-- EXIT ICON -->

            <ImageView
                android:id="@+id/btnPrivacyExit"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Close Privacy and Security"
                android:src="@drawable/exit_ic"
                app:tint="#FFFFFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ===================================================== -->
    <!-- SCROLLABLE CONTENT -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/privacyScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/privacyHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="26dp"
            android:paddingEnd="20dp"
            android:paddingBottom="110dp">


            <!-- ================================================= -->
            <!-- PRIVACY & PERMISSIONS -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:text="Privacy &amp; Permissions"
                android:textColor="#21115D"
                android:textSize="20sp" />




            <!-- ================================================= -->
            <!-- LOCATION & PERMISSIONS -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLocationPermissions"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#E8E1F2"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <!-- LOCATION ICON BACKGROUND -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/iconLocationBackground"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="14dp"
                        app:cardBackgroundColor="#F2EBFF"
                        app:cardCornerRadius="27dp"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp"
                            android:scaleType="centerInside"
                            android:contentDescription="Location and Permissions"
                            android:src="@drawable/location_button" />

                    </com.google.android.material.card.MaterialCardView>


                    <!-- LOCATION TITLE -->

                    <TextView
                        android:id="@+id/txtLocationTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:includeFontPadding="false"
                        android:text="Location &amp; Permissions"
                        android:textColor="#21115D"
                        android:textSize="16sp"
                        app:layout_constraintStart_toEndOf="@id/iconLocationBackground"
                        app:layout_constraintEnd_toStartOf="@id/txtLocationArrow"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/txtLocationSubtitle"
                        app:layout_constraintVertical_chainStyle="packed" />


                    <!-- LOCATION SUBTITLE -->

                    <TextView
                        android:id="@+id/txtLocationSubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:text="Manage location access and other app permissions."
                        android:textColor="#77718F"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@id/txtLocationTitle"
                        app:layout_constraintEnd_toEndOf="@id/txtLocationTitle"
                        app:layout_constraintTop_toBottomOf="@id/txtLocationTitle"
                        app:layout_constraintBottom_toBottomOf="parent" />


                    <!-- ARROW -->

                    <TextView
                        android:id="@+id/txtLocationArrow"
                        android:layout_width="32dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#6C2BD9"
                        android:textSize="34sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- YOUR INFORMATION -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:text="Your Information"
                android:textColor="#21115D"
                android:textSize="20sp" />




            <!-- ================================================= -->
            <!-- DATA & SECURITY -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDataSecurity"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#E8E1F2"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <!-- SECURITY ICON BACKGROUND -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/iconSecurityBackground"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="14dp"
                        app:cardBackgroundColor="#F2EBFF"
                        app:cardCornerRadius="27dp"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp"
                            android:scaleType="centerInside"
                            android:contentDescription="Data and Security"
                            android:src="@drawable/lock_ic" />

                    </com.google.android.material.card.MaterialCardView>


                    <!-- SECURITY TITLE -->

                    <TextView
                        android:id="@+id/txtSecurityTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:includeFontPadding="false"
                        android:text="Data &amp; Security"
                        android:textColor="#21115D"
                        android:textSize="16sp"
                        app:layout_constraintStart_toEndOf="@id/iconSecurityBackground"
                        app:layout_constraintEnd_toStartOf="@id/txtSecurityArrow"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/txtSecuritySubtitle"
                        app:layout_constraintVertical_chainStyle="packed" />


                    <!-- SECURITY SUBTITLE -->

                    <TextView
                        android:id="@+id/txtSecuritySubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:text="Find out how HavenApp keeps your information safe."
                        android:textColor="#77718F"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@id/txtSecurityTitle"
                        app:layout_constraintEnd_toEndOf="@id/txtSecurityTitle"
                        app:layout_constraintTop_toBottomOf="@id/txtSecurityTitle"
                        app:layout_constraintBottom_toBottomOf="parent" />


                    <!-- ARROW -->

                    <TextView
                        android:id="@+id/txtSecurityArrow"
                        android:layout_width="32dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#6C2BD9"
                        android:textSize="34sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- PRIVACY POLICY -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPrivacyPolicy"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#E8E1F2"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <!-- POLICY ICON BACKGROUND -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/iconPolicyBackground"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="14dp"
                        app:cardBackgroundColor="#F2EBFF"
                        app:cardCornerRadius="27dp"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="11dp"
                            android:scaleType="centerInside"
                            android:contentDescription="Privacy Policy"
                            android:src="@drawable/ic_privacy"
                            app:tint="#6C2BD9" />

                    </com.google.android.material.card.MaterialCardView>


                    <!-- POLICY TITLE -->

                    <TextView
                        android:id="@+id/txtPolicyTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:includeFontPadding="false"
                        android:text="Privacy Policy"
                        android:textColor="#21115D"
                        android:textSize="16sp"
                        app:layout_constraintStart_toEndOf="@id/iconPolicyBackground"
                        app:layout_constraintEnd_toStartOf="@id/txtPolicyArrow"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/txtPolicySubtitle"
                        app:layout_constraintVertical_chainStyle="packed" />


                    <!-- POLICY SUBTITLE -->

                    <TextView
                        android:id="@+id/txtPolicySubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:text="Read HavenApp's privacy policy and data practices."
                        android:textColor="#77718F"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@id/txtPolicyTitle"
                        app:layout_constraintEnd_toEndOf="@id/txtPolicyTitle"
                        app:layout_constraintTop_toBottomOf="@id/txtPolicyTitle"
                        app:layout_constraintBottom_toBottomOf="parent" />


                    <!-- ARROW -->

                    <TextView
                        android:id="@+id/txtPolicyArrow"
                        android:layout_width="32dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#6C2BD9"
                        android:textSize="34sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- PRIVACY MESSAGE -->
            <!-- ================================================= -->

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:contentDescription="Privacy and Security"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/lock_ic"
                app:tint="#6C2BD9" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Your privacy matters."
                android:textColor="#21115D"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="30dp"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="We're committed to keeping your information safe and secure."
                android:textColor="#77718F"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>


    <!-- ===================================================== -->
    <!-- FLOATING / MOVABLE HOPE ASSISTANT -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/cardHopeAssistant"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:background="@null"
        android:clickable="true"
        android:contentDescription="Open Hope Assistant"
        android:elevation="12dp"
        android:focusable="true"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chatbot"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>