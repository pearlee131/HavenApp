<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="300dp"
    android:layout_height="wrap_content"

    app:cardCornerRadius="24dp"
    app:cardElevation="8dp">


    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:gravity="center"
        android:orientation="vertical"

        android:padding="28dp">


        <ImageView

            android:layout_width="88dp"
            android:layout_height="92dp"

            android:contentDescription="Warning"

            android:src="@drawable/warning_ic" />

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="1dp"
            android:fontFamily="@font/poppins_regular"

            android:text="Account Suspended"

            android:textColor="#4a2297"

            android:textSize="22sp"

            android:textStyle="bold" />


        <TextView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_regular"

            android:gravity="center"

            android:text="You can't access your account right now.Your account has been suspended. Please contact the MSWDO Coordinator of your barangay for assistance."

            android:textColor="#555555"

            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton

            android:id="@+id/btnDialogOK"

            android:layout_width="match_parent"

            android:layout_height="50dp"

            android:layout_marginTop="24dp"

            android:backgroundTint="#4a2297"

            android:text="OK"

            android:textSize="20dp"

            android:textColor="@android:color/white"

            app:cornerRadius="25dp" />


    </LinearLayout>


</androidx.cardview.widget.CardView>