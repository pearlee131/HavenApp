<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardReportNotification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#EEE9F6"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="92dp"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">


        <!-- ================================================= -->
        <!-- STATUS ICON BACKGROUND -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNotificationIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="#F0E9FF"
            app:cardCornerRadius="13dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgNotificationIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Report update"
                android:padding="11dp"
                android:src="@drawable/ic_notification"
                app:tint="#6C2BD9" />

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- TITLE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtNotificationTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semibold"
            android:maxLines="1"
            android:text="Report Under Review"
            android:textColor="#17113F"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/viewUnreadDot"
            app:layout_constraintStart_toEndOf="@id/cardNotificationIcon"
            app:layout_constraintTop_toTopOf="@id/cardNotificationIcon" />


        <!-- ================================================= -->
        <!-- UNREAD DOT -->
        <!-- ================================================= -->

        <View
            android:id="@+id/viewUnreadDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_notification_unread_dot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- ================================================= -->
        <!-- MESSAGE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtNotificationMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_regular"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:text="Your report VAWC-2026-28-00003 is now under review."
            android:textColor="#625D70"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardNotificationIcon"
            app:layout_constraintTop_toBottomOf="@id/txtNotificationTitle" />


        <!-- ================================================= -->
        <!-- CASE NUMBER -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtNotificationCaseNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="7dp"
            android:fontFamily="@font/poppins_medium"
            android:text="VAWC-2026-28-00003"
            android:textColor="#6C2BD9"
            android:textSize="9sp"
            app:layout_constraintStart_toEndOf="@id/cardNotificationIcon"
            app:layout_constraintTop_toBottomOf="@id/txtNotificationMessage" />


        <!-- ================================================= -->
        <!-- TIME -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtNotificationTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:fontFamily="@font/poppins_regular"
            android:text="10:42 AM"
            android:textColor="#98939F"
            android:textSize="9sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtNotificationMessage" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>