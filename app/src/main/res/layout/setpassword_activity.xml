<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/plain_bg">


    <!-- MAIN CONTENT -->

    <androidx.constraintlayout.widget.ConstraintLayout

        android:id="@+id/contentLayout"

        android:layout_width="0dp"

        android:layout_height="wrap_content"

        android:paddingStart="@dimen/container_padding"

        android:paddingEnd="@dimen/container_padding"


        app:layout_constraintTop_toTopOf="parent"

        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintVertical_bias="0.40">


        <!-- IMAGE -->

        <ImageView

            android:id="@+id/imgSetPassword"

            android:layout_width="@dimen/set_password_image_size"

            android:layout_height="@dimen/set_password_image_size"

            android:scaleType="fitCenter"

            android:src="@drawable/forgot_password"


            app:layout_constraintTop_toTopOf="parent"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent"/>




        <!-- TITLE -->

        <TextView

            android:id="@+id/txtTitle"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/space_medium"

            android:fontFamily="@font/poppins_bold"

            android:text="Set a New Password"

            android:textColor="@android:color/black"

            android:textSize="@dimen/title_text_size"


            app:layout_constraintTop_toBottomOf="@id/imgSetPassword"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent"/>





        <!-- SUBTITLE -->

        <TextView

            android:id="@+id/txtSubtitle"

            android:layout_width="0dp"

            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/space_small"

            android:fontFamily="@font/poppins_regular"

            android:gravity="center"

            android:text="Your new password must be different from previously used passwords."

            android:textAlignment="center"

            android:textColor="#666666"

            android:textSize="@dimen/subtitle_text_size"


            app:layout_constraintTop_toBottomOf="@id/txtTitle"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent"/>





        <!-- NEW PASSWORD LABEL -->

        <TextView

            android:id="@+id/txtNewPassword"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/space_xlarge"

            android:fontFamily="@font/poppins_medium"

            android:text="New Password"

            android:textColor="@color/violet"

            android:textSize="@dimen/label_text"


            app:layout_constraintTop_toBottomOf="@id/txtSubtitle"

            app:layout_constraintStart_toStartOf="parent"/>





        <!-- NEW PASSWORD FIELD -->

        <com.google.android.material.textfield.TextInputLayout

            android:id="@+id/tilNewPassword"

            android:layout_width="0dp"

            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/space_small"


            app:boxBackgroundMode="outline"

            app:boxCornerRadiusBottomEnd="@dimen/corner_radius"

            app:boxCornerRadiusBottomStart="@dimen/corner_radius"

            app:boxCornerRadiusTopEnd="@dimen/corner_radius"

            app:boxCornerRadiusTopStart="@dimen/corner_radius"

            app:boxStrokeColor="@color/violet"

            app:endIconMode="password_toggle"

            app:endIconTint="@color/violet"


            app:layout_constraintTop_toBottomOf="@id/txtNewPassword"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent">


            <com.google.android.material.textfield.TextInputEditText

                android:id="@+id/etNewPassword"

                android:layout_width="match_parent"

                android:layout_height="@dimen/input_height"

                android:hint="Enter New Password"

                android:inputType="textPassword"

                android:textSize="@dimen/input_text"/>


        </com.google.android.material.textfield.TextInputLayout>





        <!-- CONFIRM LABEL -->

        <TextView

            android:id="@+id/txtConfirmPassword"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/space_medium"

            android:fontFamily="@font/poppins_medium"

            android:text="Confirm Password"

            android:textColor="@color/violet"

            android:textSize="@dimen/label_text"


            app:layout_constraintTop_toBottomOf="@id/tilNewPassword"

            app:layout_constraintStart_toStartOf="parent"/>





        <!-- CONFIRM PASSWORD FIELD -->

        <com.google.android.material.textfield.TextInputLayout

            android:id="@+id/tilConfirmPassword"

            android:layout_width="0dp"

            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/space_small"


            app:boxBackgroundMode="outline"

            app:boxCornerRadiusBottomEnd="@dimen/corner_radius"

            app:boxCornerRadiusBottomStart="@dimen/corner_radius"

            app:boxCornerRadiusTopEnd="@dimen/corner_radius"

            app:boxCornerRadiusTopStart="@dimen/corner_radius"

            app:boxStrokeColor="@color/violet"

            app:endIconMode="password_toggle"

            app:endIconTint="@color/violet"


            app:layout_constraintTop_toBottomOf="@id/txtConfirmPassword"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent">


            <com.google.android.material.textfield.TextInputEditText

                android:id="@+id/etConfirmPassword"

                android:layout_width="match_parent"

                android:layout_height="@dimen/input_height"

                android:hint="Confirm New Password"

                android:inputType="textPassword"

                android:textSize="@dimen/input_text"/>


        </com.google.android.material.textfield.TextInputLayout>





        <!-- RESET BUTTON -->

        <com.google.android.material.button.MaterialButton

            android:id="@+id/btnResetPassword"

            android:layout_width="0dp"

            android:layout_height="@dimen/button_height"

            android:layout_marginTop="@dimen/space_large"

            android:fontFamily="@font/poppins_bold"

            android:text="Reset Password"

            android:textAllCaps="false"

            android:textColor="@android:color/white"

            android:textSize="@dimen/button_text_size"


            app:backgroundTint="@color/violet"

            app:cornerRadius="@dimen/corner_radius"


            app:layout_constraintTop_toBottomOf="@id/tilConfirmPassword"

            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>





    <!-- BOTTOM PROGRESS -->

    <LinearLayout

        android:id="@+id/progressLayout"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:orientation="horizontal"

        android:layout_marginBottom="@dimen/space_xlarge"


        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent">


        <View

            android:layout_width="@dimen/progress_width"

            android:layout_height="@dimen/progress_height"

            android:layout_marginEnd="@dimen/space_small"

            android:background="@drawable/progress_active"/>


        <View

            android:layout_width="@dimen/progress_width"

            android:layout_height="@dimen/progress_height"

            android:layout_marginEnd="@dimen/space_small"

            android:background="@drawable/progress_active"/>


        <View

            android:layout_width="@dimen/progress_width"

            android:layout_height="@dimen/progress_height"

            android:layout_marginEnd="@dimen/space_small"

            android:background="@drawable/progress_active"/>


        <View

            android:layout_width="@dimen/progress_width"

            android:layout_height="@dimen/progress_height"

            android:background="@drawable/progress_inactive"/>


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>