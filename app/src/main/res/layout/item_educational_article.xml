<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardEducationalArticle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">


        <!-- ================================================= -->
        <!-- ARTICLE IMAGE / ICON -->
        <!-- ================================================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardArticleImage"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:cardBackgroundColor="#F8D7DC"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">


            <ImageView
                android:id="@+id/imgArticleThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_articles"
                android:contentDescription="Educational article image"
                 />

        </androidx.cardview.widget.CardView>


        <!-- ================================================= -->
        <!-- ARTICLE INFORMATION -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">


            <!-- TITLE -->

            <TextView
                android:id="@+id/txtArticleTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Educational Article"
                android:textColor="#17113F"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="2"
                android:ellipsize="end" />


            <!-- SUBTITLE -->

            <TextView
                android:id="@+id/txtArticleSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Learn more about VAWC awareness and safety."
                android:textColor="#625775"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_regular"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp" />


            <!-- SOURCE -->

            <TextView
                android:id="@+id/txtArticleSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Official Source"
                android:textColor="#6C2BD9"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_medium"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>