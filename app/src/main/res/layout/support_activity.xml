<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F6FF">


    <!-- ================================================= -->
    <!-- FIXED SUPPORT HEADER + FILE A NEW REPORT -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/fixedSupportTop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/support_horizontal_padding"
        android:paddingTop="@dimen/support_top_padding"
        android:paddingEnd="@dimen/support_horizontal_padding"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- ================================================= -->
        <!-- SUPPORT CONTENT -->
        <!-- ================================================= -->

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/support_header_text_end_margin"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/supportTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Support"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:textColor="#32118F"
                    android:textSize="@dimen/support_title_size"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/supportSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="@dimen/support_subtitle_line_spacing"
                    android:text="We're here to help. File a report, track its progress, and get the support you deserve."
                    android:textColor="#504467"
                    android:textSize="@dimen/support_subtitle_size" />


            </LinearLayout>


            <!-- ================================================= -->
            <!-- NOTIFICATION BELL + UNREAD BADGE -->
            <!-- ================================================= -->

            <FrameLayout
                android:id="@+id/supportNotificationContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/support_notification_margin_top"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/notificationBell"
                    android:layout_width="@dimen/support_notification_size"
                    android:layout_height="@dimen/support_notification_size"
                    android:clickable="true"
                    android:contentDescription="Notifications"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_notification" />

                <TextView
                    android:id="@+id/txtSupportNotificationBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_notification_badge"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="18dp"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:visibility="gone" />

            </FrameLayout>


        </RelativeLayout>


        <!-- ================================================= -->
        <!-- FILE A NEW REPORT -->
        <!-- ================================================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/btnFileNewReport"
            android:layout_width="match_parent"
            android:layout_height="@dimen/support_new_report_height"
            android:layout_marginTop="@dimen/support_new_report_margin_top"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardBackgroundColor="#4a2297"
            app:cardCornerRadius="@dimen/support_main_card_radius"
            app:cardElevation="@dimen/support_main_card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/support_new_report_padding_start"
                android:paddingEnd="@dimen/support_new_report_padding_end">


                <ImageView
                    android:layout_width="@dimen/support_new_report_icon_width"
                    android:layout_height="@dimen/support_new_report_icon_height"
                    android:contentDescription="File a New Report"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_addreport" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/support_new_report_text_margin"
                    android:layout_weight="1"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="File a New Report"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/support_new_report_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/support_new_report_subtitle_margin"
                        android:fontFamily="@font/poppins_semibold"
                        android:lineSpacingExtra="@dimen/support_subtitle_line_spacing"
                        android:text="Report an incident and get the support you need"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/support_new_report_subtitle_size"
                        android:textStyle="bold" />


                </LinearLayout>


            </LinearLayout>


        </androidx.cardview.widget.CardView>



    </LinearLayout>


    <!-- ================================================= -->
    <!-- SCROLLABLE SUPPORT CONTENT -->
    <!-- MY REPORTS / DRAFTS / NEED HELP + OVERVIEW + RECENT -->
    <!-- ================================================= -->

    <ScrollView
        android:id="@+id/supportScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:fadeScrollbars="true"
        app:layout_constraintTop_toBottomOf="@id/fixedSupportTop"
        app:layout_constraintBottom_toTopOf="@id/bottomNavbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/support_horizontal_padding"
            android:paddingEnd="@dimen/support_horizontal_padding"
            android:paddingBottom="@dimen/support_bottom_padding">


            <!-- ================================================= -->
            <!-- QUICK ACTION CARDS -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/support_quick_actions_height"
                android:layout_marginTop="@dimen/support_quick_actions_margin_top"
                android:baselineAligned="false"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">


                <!-- ================================================= -->
                <!-- MY REPORTS -->
                <!-- ================================================= -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnMyReports"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/support_quick_card_half_spacing"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="@dimen/support_quick_card_radius"
                    app:cardElevation="@dimen/support_quick_card_elevation">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/support_quick_card_horizontal_padding"
                        android:paddingTop="@dimen/support_quick_card_top_padding"
                        android:paddingEnd="@dimen/support_quick_card_horizontal_padding"
                        android:paddingBottom="@dimen/support_quick_card_bottom_padding">


                        <ImageView
                            android:layout_width="@dimen/support_quick_icon_size"
                            android:layout_height="@dimen/support_quick_icon_size"
                            android:contentDescription="My Reports"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_report" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/support_quick_title_margin_top"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="My Reports"
                            android:textColor="#24134C"
                            android:textSize="@dimen/support_quick_title_size"
                            android:textStyle="bold" />


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="@dimen/support_quick_description_margin_top"
                            android:layout_weight="1"
                            android:gravity="top|center_horizontal"
                            android:lineSpacingExtra="@dimen/support_quick_line_spacing"
                            android:fontFamily="@font/poppins_regular"
                            android:text="View and track\nyour submitted\nreports."
                            android:textAlignment="center"
                            android:textColor="#63557F"
                            android:textSize="8sp" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="›"
                            android:textColor="#6C2BD9"
                            android:textSize="@dimen/support_quick_arrow_size"
                            android:textStyle="bold" />


                    </LinearLayout>


                </androidx.cardview.widget.CardView>


                <!-- ================================================= -->
                <!-- DRAFTS -->
                <!-- ================================================= -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnDrafts"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/support_quick_card_half_spacing"
                    android:layout_marginEnd="@dimen/support_quick_card_half_spacing"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="@dimen/support_quick_card_radius"
                    app:cardElevation="@dimen/support_quick_card_elevation">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/support_quick_card_horizontal_padding"
                        android:paddingTop="@dimen/support_quick_card_top_padding"
                        android:paddingEnd="@dimen/support_quick_card_horizontal_padding"
                        android:paddingBottom="@dimen/support_quick_card_bottom_padding">


                        <ImageView
                            android:layout_width="@dimen/support_quick_icon_size"
                            android:layout_height="@dimen/support_quick_icon_size"
                            android:contentDescription="Drafts"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_drafts" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/support_quick_title_margin_top"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center"
                            android:text="Drafts"
                            android:textColor="#24134C"
                            android:textSize="@dimen/support_quick_title_size"
                            android:textStyle="bold" />


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="@dimen/support_quick_description_margin_top"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="top|center_horizontal"
                            android:lineSpacingExtra="@dimen/support_quick_line_spacing"
                            android:text="Continue your\nunfinished\nreports."
                            android:textAlignment="center"
                            android:textColor="#63557F"
                            android:textSize="8sp" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="›"
                            android:textColor="#6C2BD9"
                            android:textSize="@dimen/support_quick_arrow_size"
                            android:textStyle="bold" />


                    </LinearLayout>


                </androidx.cardview.widget.CardView>


                <!-- ================================================= -->
                <!-- NEED HELP -->
                <!-- ================================================= -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnNeedHelp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/support_quick_card_half_spacing"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="@dimen/support_quick_card_radius"
                    app:cardElevation="@dimen/support_quick_card_elevation">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/support_quick_card_horizontal_padding"
                        android:paddingTop="@dimen/support_quick_card_top_padding"
                        android:paddingEnd="@dimen/support_quick_card_horizontal_padding"
                        android:paddingBottom="@dimen/support_quick_card_bottom_padding">


                        <ImageView
                            android:layout_width="@dimen/support_quick_icon_size"
                            android:layout_height="@dimen/support_quick_icon_size"
                            android:contentDescription="Need Help"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_chatsupport" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/support_quick_title_margin_top"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Need Help?"
                            android:textColor="#24134C"
                            android:textSize="@dimen/support_quick_title_size"
                            android:textStyle="bold" />


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="@dimen/support_quick_description_margin_top"
                            android:layout_weight="1"
                            android:gravity="top|center_horizontal"
                            android:lineSpacingExtra="@dimen/support_quick_line_spacing"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Chat with our\nAI support\nassistant."
                            android:textAlignment="center"
                            android:textColor="#63557F"
                            android:textSize="8sp" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="›"
                            android:textColor="#6C2BD9"
                            android:textSize="@dimen/support_quick_arrow_size"
                            android:textStyle="bold" />


                    </LinearLayout>


                </androidx.cardview.widget.CardView>


            </LinearLayout>


            <!-- ================================================= -->
            <!-- MY REPORTS OVERVIEW -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/reportsOverviewCard"
                android:layout_width="match_parent"
                android:layout_height="@dimen/support_overview_height"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/support_section_card_radius"
                app:cardElevation="@dimen/support_quick_card_elevation"
                app:cardUseCompatPadding="false">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/support_section_horizontal_padding"
                    android:paddingTop="@dimen/support_section_top_padding"
                    android:paddingEnd="@dimen/support_section_horizontal_padding"
                    android:paddingBottom="@dimen/support_section_bottom_padding">


                    <!-- OVERVIEW HEADER -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="My Reports Overview"
                            android:textColor="#21135E"
                            android:textSize="@dimen/support_section_title_size"
                            android:textStyle="bold" />


                    </LinearLayout>


                    <!-- ================================================= -->
                    <!-- OVERVIEW ITEMS -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/support_overview_items_margin_top"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">


                        <!-- TOTAL REPORTS -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">


                            <ImageView
                                android:layout_width="@dimen/support_overview_icon_size"
                                android:layout_height="@dimen/support_overview_icon_size"
                                android:contentDescription="Total Reports"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_reports" />


                            <TextView
                                android:id="@+id/textTotalReports"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/support_overview_number_margin_top"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="0"
                                android:textColor="#6C2BD9"
                                android:textSize="@dimen/support_overview_number_size"
                                android:textStyle="bold" />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/support_overview_label_margin_top"
                                android:fontFamily="@font/poppins_regular"
                                android:gravity="center"
                                android:text="Total Reports"
                                android:textColor="#443B72"
                                android:textSize="@dimen/support_overview_label_size" />


                        </LinearLayout>


                        <View
                            android:layout_width="@dimen/support_divider_width"
                            android:layout_height="@dimen/support_overview_divider_height"
                            android:background="#ECE8F2" />


                        <!-- ACTIVE -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">


                            <ImageView
                                android:layout_width="@dimen/support_overview_icon_size"
                                android:layout_height="@dimen/support_overview_icon_size"
                                android:contentDescription="Active Reports"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_active" />


                            <TextView
                                android:id="@+id/textActiveReports"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/support_overview_number_margin_top"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="0"
                                android:textColor="#FF7A20"
                                android:textSize="@dimen/support_overview_number_size"
                                android:textStyle="bold" />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/support_overview_label_margin_top"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Active"
                                android:textColor="#443B72"
                                android:textSize="@dimen/support_overview_label_size" />


                        </LinearLayout>


                        <View
                            android:layout_width="@dimen/support_divider_width"
                            android:layout_height="@dimen/support_overview_divider_height"
                            android:background="#ECE8F2" />


                        <!-- RESOLVED -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">


                            <ImageView
                                android:layout_width="@dimen/support_overview_icon_size"
                                android:layout_height="@dimen/support_overview_icon_size"
                                android:contentDescription="Resolved Reports"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_resolved" />


                            <TextView
                                android:id="@+id/textResolvedReports"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/support_overview_number_margin_top"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="0"
                                android:textColor="#1EBF73"
                                android:textSize="@dimen/support_overview_number_size"
                                android:textStyle="bold" />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/support_overview_label_margin_top"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Resolved"
                                android:textColor="#443B72"
                                android:textSize="@dimen/support_overview_label_size" />


                        </LinearLayout>


                        <View
                            android:layout_width="@dimen/support_divider_width"
                            android:layout_height="@dimen/support_overview_divider_height"
                            android:background="#ECE8F2" />


                        <!-- DRAFTS -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">


                            <ImageView
                                android:layout_width="@dimen/support_overview_icon_size"
                                android:layout_height="@dimen/support_overview_icon_size"
                                android:contentDescription="Draft Reports"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_draft" />


                            <TextView
                                android:id="@+id/textDraftReports"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/support_overview_number_margin_top"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="0"
                                android:textColor="#24134C"
                                android:textSize="@dimen/support_overview_number_size"
                                android:textStyle="bold" />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/support_overview_label_margin_top"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Drafts"
                                android:textColor="#443B72"
                                android:textSize="@dimen/support_overview_label_size" />


                        </LinearLayout>


                    </LinearLayout>


                </LinearLayout>


            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- RECENT REPORTS -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/recentReportsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/support_section_card_radius"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="false">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/support_section_horizontal_padding"
                    android:paddingTop="@dimen/support_section_top_padding"
                    android:paddingEnd="@dimen/support_section_horizontal_padding"
                    android:paddingBottom="@dimen/support_recent_bottom_padding">


                    <!-- RECENT REPORTS HEADER -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/textRecentReportsTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Recent Reports"
                            android:textColor="#21135E"
                            android:textSize="@dimen/support_section_title_size"
                            android:textStyle="bold" />


                    </LinearLayout>


                    <!-- RECENT REPORTS CONTENT -->

                    <LinearLayout
                        android:id="@+id/recentReportsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/support_recent_content_margin_top"
                        android:orientation="vertical">


                        <TextView
                            android:id="@+id/textNoRecentReports"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/support_no_reports_height"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_regular"
                            android:text="No recent reports yet."
                            android:textColor="#8B819D"
                            android:textSize="@dimen/support_no_reports_size" />


                    </LinearLayout>


                </LinearLayout>


            </androidx.cardview.widget.CardView>


            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />


        </LinearLayout>

    </ScrollView>

    <!-- ================================================= -->
    <!-- FLOATING / MOVABLE HOPE ASSISTANT -->
    <!-- ================================================= -->

    <ImageView
        android:id="@+id/cardHopeAssistant"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:background="@null"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Open Hope Assistant"
        android:elevation="12dp"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chatbot"
        app:layout_constraintBottom_toTopOf="@id/bottomNavbar"
        app:layout_constraintEnd_toEndOf="parent" />
    <!-- ================================================= -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ================================================= -->

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/navbar_height"
        android:layout_marginStart="@dimen/navbar_margin_horizontal"
        android:layout_marginEnd="@dimen/navbar_margin_horizontal"
        android:layout_marginBottom="@dimen/navbar_margin_bottom"
        android:backgroundTint="#F0E8FF"
        app:cardCornerRadius="35dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">


            <!-- HOME -->

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">


                <ImageView
                    android:id="@+id/homeIcon"
                    android:layout_width="@dimen/navbar_icon_size"
                    android:layout_height="@dimen/navbar_icon_size"
                    android:src="@drawable/home_button" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/navbar_text_margin_top"
                    android:text="Home"
                    android:textColor="#777777"
                    android:textSize="@dimen/navbar_text_size" />


            </LinearLayout>


            <!-- SUPPORT -->

            <LinearLayout
                android:id="@+id/navSupport"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">


                <ImageView
                    android:layout_width="@dimen/navbar_icon_size"
                    android:layout_height="@dimen/navbar_icon_size"
                    android:src="@drawable/support_button" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/navbar_text_margin_top"
                    android:text="Support"
                    android:textColor="#6C2BD9"
                    android:textSize="@dimen/navbar_text_size"
                    android:textStyle="bold" />


            </LinearLayout>


            <!-- EXPLORE -->

            <LinearLayout
                android:id="@+id/navExplore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">


                <ImageView
                    android:layout_width="@dimen/navbar_icon_size"
                    android:layout_height="@dimen/navbar_icon_size"
                    android:src="@drawable/explore_button" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/navbar_text_margin_top"
                    android:text="Explore"
                    android:textColor="#777777"
                    android:textSize="@dimen/navbar_text_size" />


            </LinearLayout>


            <!-- PROFILE -->

            <LinearLayout
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">


                <ImageView
                    android:layout_width="@dimen/navbar_icon_size"
                    android:layout_height="@dimen/navbar_icon_size"
                    android:src="@drawable/profile_button" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/navbar_text_margin_top"
                    android:text="Profile"
                    android:textColor="#777777"
                    android:textSize="@dimen/navbar_text_size" />


            </LinearLayout>


        </LinearLayout>


    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>
