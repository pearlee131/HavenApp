<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F6FF">


    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/articleDetailsHeader"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="#6C2BD9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            android:padding="10dp"
            android:src="@drawable/exit_ic"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true"
            app:tint="@android:color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />


        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="54dp"
            android:text="Educational Article"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:gravity="center"
            android:fontFamily="@font/poppins_semibold"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ================================================= -->
    <!-- LOADING -->
    <!-- ================================================= -->

    <ProgressBar
        android:id="@+id/progressArticleDetails"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/articleDetailsHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ================================================= -->
    <!-- ARTICLE CONTENT -->
    <!-- ================================================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/articleDetailsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/articleDetailsHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/support_horizontal_padding"
            android:paddingEnd="@dimen/support_horizontal_padding"
            android:paddingTop="20dp"
            android:paddingBottom="36dp">


            <!-- ========================================= -->
            <!-- ARTICLE HERO IMAGE -->
            <!-- ========================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardArticleHero"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                app:cardBackgroundColor="#F0E5FF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">


                <ImageView
                    android:id="@+id/imgArticleHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="45dp"
                    android:src="@drawable/ic_articles"
                    android:scaleType="centerInside"
                    android:contentDescription="Educational article image"
                    app:tint="#6C2BD9" />

            </androidx.cardview.widget.CardView>


            <!-- ========================================= -->
            <!-- CATEGORY -->
            <!-- ========================================= -->

            <TextView
                android:id="@+id/txtArticleCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_legal_category_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="EDUCATIONAL ARTICLES"
                android:textColor="#6C2BD9"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_semibold" />


            <!-- ========================================= -->
            <!-- TITLE -->
            <!-- ========================================= -->

            <TextView
                android:id="@+id/txtArticleTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Educational Article"
                android:textColor="#32118F"
                android:textSize="22sp"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/poppins_bold" />


            <!-- ========================================= -->
            <!-- SUBTITLE -->
            <!-- ========================================= -->

            <TextView
                android:id="@+id/txtArticleSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Helpful information about awareness and safety."
                android:textColor="#62586F"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/poppins_regular" />


            <!-- ========================================= -->
            <!-- SOURCE -->
            <!-- ========================================= -->

            <TextView
                android:id="@+id/txtArticleSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Source: Official Source"
                android:textColor="#6C2BD9"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_medium" />


            <!-- ========================================= -->
            <!-- DIVIDER -->
            <!-- ========================================= -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="#E6DEEE" />


            <!-- ========================================= -->
            <!-- FULL ARTICLE CONTENT -->
            <!-- ========================================= -->

            <TextView
                android:id="@+id/txtArticleContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Article content will appear here."
                android:textColor="#403849"
                android:textSize="14sp"
                android:lineSpacingExtra="6dp"
                android:fontFamily="@font/poppins_regular"
                android:textIsSelectable="true" />


            <!-- ========================================= -->
            <!-- OFFICIAL SOURCE -->
            <!-- ========================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardOfficialSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Official Source"
                        android:textColor="#746A82"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins_medium" />


                    <TextView
                        android:id="@+id/txtOfficialSourceName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Official Source"
                        android:textColor="#32118F"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_semibold" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="View Official Source"
                        android:textColor="#6C2BD9"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_semibold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ========================================= -->
            <!-- EDUCATIONAL NOTICE -->
            <!-- ========================================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="#F0E5FF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:padding="16dp">


                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_legal_info_circle">


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="i"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_semibold" />

                    </FrameLayout>


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="This material is provided for educational and awareness purposes. For legal guidance, refer to the Legal Rights section. If immediate assistance is needed, use HavenApp's Emergency Hotlines."
                        android:textColor="#504467"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        android:fontFamily="@font/poppins_regular" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ================================================= -->
    <!-- ERROR STATE -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/layoutArticleError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="30dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/articleDetailsHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:src="@drawable/ic_articles"
            android:contentDescription="Unable to load article"
            app:tint="#6C2BD9" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Unable to load article"
            android:textColor="#32118F"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Please check your connection and try again."
            android:textColor="#746A82"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_regular" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>