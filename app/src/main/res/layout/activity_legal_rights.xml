<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F6FF">


    <!-- ================================================= -->
    <!-- PURPLE ROUNDED HEADER -->
    <!-- FIXED -->
    <!-- ================================================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/legalRightsHeader"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="18dp"
        app:cardBackgroundColor="#6C2BD9"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="18dp"
            android:paddingEnd="12dp">


            <!-- ================================================= -->
            <!-- HEADER TITLE -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtLegalRightsHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:text="Legal Rights"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/txtLegalRightsHeaderSubtitle"
                app:layout_constraintEnd_toStartOf="@id/btnBack"
                app:layout_constraintVertical_chainStyle="packed" />


            <!-- ================================================= -->
            <!-- HEADER SUBTITLE -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtLegalRightsHeaderSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Know your rights. Understand your protection."
                android:textColor="#E9DFFF"
                android:textSize="10sp"
                app:layout_constraintStart_toStartOf="@id/txtLegalRightsHeaderTitle"
                app:layout_constraintTop_toBottomOf="@id/txtLegalRightsHeaderTitle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnBack" />


            <!-- ================================================= -->
            <!-- EXIT / BACK BUTTON -->
            <!-- ================================================= -->

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back"
                android:src="@drawable/exit_ic"
                app:tint="#FFFFFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ================================================= -->
    <!-- KNOW YOUR RIGHTS -->
    <!-- FIXED / STICKY -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/txtArticlesTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/support_horizontal_padding"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="@dimen/support_horizontal_padding"
        android:fontFamily="@font/poppins_bold"
        android:includeFontPadding="false"
        android:text="Know Your Rights"
        android:textColor="#17113F"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/legalRightsHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ================================================= -->
    <!-- SCROLLABLE CONTENT -->
    <!-- STARTS WITH FIRST ARTICLE -->
    <!-- ================================================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/legalRightsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/txtArticlesTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/support_horizontal_padding"
            android:paddingEnd="@dimen/support_horizontal_padding"
            android:paddingBottom="28dp">


            <!-- ================================================= -->
            <!-- LOADING INDICATOR -->
            <!-- ================================================= -->

            <ProgressBar
                android:id="@+id/progressLegalArticles"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:indeterminateTint="#6C2BD9"
                android:visibility="gone" />


            <!-- ================================================= -->
            <!-- FIRST ARTICLE STARTS HERE -->
            <!-- ENTIRE ARTICLE LIST SCROLLS -->
            <!-- ================================================= -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerLegalArticles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:scrollbars="none" />


            <!-- ================================================= -->
            <!-- EMPTY STATE -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/layoutLegalEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="No articles available"
                    android:textColor="#32118F"
                    android:textSize="14sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:text="Legal Rights information will appear here when available."
                    android:textColor="#766D87"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- EDUCATIONAL DISCLAIMER -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardLegalDisclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="#EEE6FA"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp" />


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>