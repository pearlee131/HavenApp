<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F6FF">


    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- EXIT BUTTON REMOVED -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtNotificationDetailsHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="Notification Details"
        android:textColor="#17113F"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ===================================================== -->
    <!-- REPORT STATUS ICON -->
    <!-- USES YOUR REPORT ICON -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNotificationDetailsIcon"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_marginTop="54dp"
        app:cardBackgroundColor="#EEE3FF"
        app:cardCornerRadius="46dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtNotificationDetailsHeader">

        <ImageView
            android:id="@+id/imgNotificationDetailsIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Report status update"
            android:padding="22dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_report" />

    </com.google.android.material.card.MaterialCardView>


    <!-- ===================================================== -->
    <!-- NOTIFICATION TITLE -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtNotificationDetailsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="Report Under Review"
        android:textColor="#17113F"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardNotificationDetailsIcon" />


    <!-- ===================================================== -->
    <!-- DATE AND TIME -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtNotificationDetailsTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/poppins_regular"
        android:includeFontPadding="false"
        android:text="Today, 2:15 PM"
        android:textColor="#6E6685"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtNotificationDetailsTitle" />


    <!-- ===================================================== -->
    <!-- MESSAGE CARD -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNotificationDetailsMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="22dp"
        app:cardBackgroundColor="#F0E9FC"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtNotificationDetailsTime">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="205dp"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">


            <!-- MAIN NOTIFICATION MESSAGE -->

            <TextView
                android:id="@+id/txtNotificationDetailsMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:includeFontPadding="false"
                android:text="Your report #VAWC-2026-0021 is now under review."
                android:textColor="#17113F"
                android:textSize="15sp" />


            <!-- SUPPORTING MESSAGE -->

            <TextView
                android:id="@+id/txtNotificationDetailsSupportingMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:lineSpacingExtra="3dp"
                android:text="Our team is currently reviewing the details of your report. You will be notified once there are updates."
                android:textColor="#514A6A"
                android:textSize="14sp" />


            <!-- CLOSING MESSAGE -->
            <!-- Kept because your Java uses this ID -->

            <TextView
                android:id="@+id/txtNotificationDetailsClosing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:text="Thank you for trusting HavenApp."
                android:textColor="#514A6A"
                android:textSize="14sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ===================================================== -->
    <!-- FLOATING / MOVABLE HOPE ASSISTANT -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/cardHopeAssistant"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:background="@null"
        android:clickable="true"
        android:contentDescription="Open Hope Assistant"
        android:elevation="12dp"
        android:focusable="true"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chatbot"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- GOT IT BUTTON -->
    <!-- THIS IS NOW THE ONLY EXIT ACTION -->
    <!-- ===================================================== -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNotificationGotIt"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="30dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Got it"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:backgroundTint="#4a2297"
        app:cornerRadius="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardNotificationDetailsMessage" />


</androidx.constraintlayout.widget.ConstraintLayout>