<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F6FF">


    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/privacyPolicyHeader"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="18dp"
        app:cardBackgroundColor="#4a2297"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="18dp"
            android:paddingEnd="12dp">


            <!-- TITLE -->

            <TextView
                android:id="@+id/txtPrivacyPolicyTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:text="Privacy Policy"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/txtPrivacyPolicySubtitle"
                app:layout_constraintEnd_toStartOf="@id/btnPrivacyPolicyExit"
                app:layout_constraintVertical_chainStyle="packed" />


            <!-- SUBTITLE -->

            <TextView
                android:id="@+id/txtPrivacyPolicySubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="How we handle your information."
                android:textColor="#E9DFFF"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="@id/txtPrivacyPolicyTitle"
                app:layout_constraintTop_toBottomOf="@id/txtPrivacyPolicyTitle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnPrivacyPolicyExit" />


            <!-- EXIT -->

            <ImageView
                android:id="@+id/btnPrivacyPolicyExit"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Close Privacy Policy"
                android:src="@drawable/exit_ic"
                app:tint="#FFFFFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ===================================================== -->
    <!-- SCROLLABLE PRIVACY POLICY -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/privacyPolicyScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/privacyPolicyHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="25dp">


            <!-- ================================================= -->
            <!-- 1. INFORMATION WE COLLECT -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:orientation="horizontal">


                <!-- TIMELINE -->

                <LinearLayout
                    android:layout_width="64dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        app:cardBackgroundColor="#F0E8FF"
                        app:cardCornerRadius="27dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="15dp"
                            android:contentDescription="Information We Collect"
                            android:src="@drawable/ic_privacy"
                            app:tint="#6C2BD9" />

                    </com.google.android.material.card.MaterialCardView>


                    <View
                        android:layout_width="2dp"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:background="#D9C9FA" />


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        app:cardBackgroundColor="#BDA2F5"
                        app:cardCornerRadius="4dp"
                        app:cardElevation="0dp" />

                </LinearLayout>


                <!-- CONTENT -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:text="Information We Collect"
                        android:textColor="#21115D"
                        android:textSize="16sp" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="HavenApp handles information you provide through your account and use of the app, including profile information, incident report details, uploaded attachments, and location information when you choose to share it or use an emergency feature that requires location."
                        android:textColor="#625C82"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- 2. HOW WE USE YOUR INFORMATION -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">


                <LinearLayout
                    android:layout_width="64dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        app:cardBackgroundColor="#F0E8FF"
                        app:cardCornerRadius="27dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="15dp"
                            android:contentDescription="How We Use Your Information"
                            android:src="@drawable/ic_privacy"
                            app:tint="#6C2BD9" />

                    </com.google.android.material.card.MaterialCardView>


                    <View
                        android:layout_width="2dp"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:background="#D9C9FA" />


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        app:cardBackgroundColor="#BDA2F5"
                        app:cardCornerRadius="4dp"
                        app:cardElevation="0dp" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:text="How We Use Your Information"
                        android:textColor="#21115D"
                        android:textSize="16sp" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="HavenApp uses your information to provide HavenApp's features, support incident reporting and case handling, provide relevant assistance, and operate emergency and location-related functionality."
                        android:textColor="#625C82"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- 3. LOCATION INFORMATION -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">


                <LinearLayout
                    android:layout_width="64dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        app:cardBackgroundColor="#F0E8FF"
                        app:cardCornerRadius="27dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="15dp"
                            android:contentDescription="Location Information"
                            android:src="@drawable/ic_privacy"
                            app:tint="#6C2BD9" />

                    </com.google.android.material.card.MaterialCardView>


                    <View
                        android:layout_width="2dp"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:background="#D9C9FA" />


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        app:cardBackgroundColor="#BDA2F5"
                        app:cardCornerRadius="4dp"
                        app:cardElevation="0dp" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:text="Location Information"
                        android:textColor="#21115D"
                        android:textSize="16sp" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="HavenApp uses location information when you choose to share your current location and during applicable emergency features. During an emergency call, location updates may be used while the emergency call is active to support the response."
                        android:textColor="#625C82"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- 4. INFORMATION SHARING -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">


                <LinearLayout
                    android:layout_width="64dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        app:cardBackgroundColor="#F0E8FF"
                        app:cardCornerRadius="27dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="15dp"
                            android:contentDescription="Information Sharing"
                            android:src="@drawable/ic_privacy"
                            app:tint="#6C2BD9" />

                    </com.google.android.material.card.MaterialCardView>


                    <View
                        android:layout_width="2dp"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:background="#D9C9FA" />


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        app:cardBackgroundColor="#BDA2F5"
                        app:cardCornerRadius="4dp"
                        app:cardElevation="0dp" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:text="Information Sharing"
                        android:textColor="#21115D"
                        android:textSize="16sp" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="Information connected to a report or request for assistance may be accessible to authorized personnel responsible for handling the report and providing support, including the appropriate Barangay VAWC personnel and MSWDO where applicable."
                        android:textColor="#625C82"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- 5. DATA PROTECTION -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">


                <!-- FINAL TIMELINE -->

                <LinearLayout
                    android:layout_width="64dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">


                    <!-- DATA PROTECTION ICON -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        app:cardBackgroundColor="#F0E8FF"
                        app:cardCornerRadius="27dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="15dp"
                            android:contentDescription="Data Protection"
                            android:src="@drawable/ic_privacy"
                            app:tint="#6C2BD9" />

                    </com.google.android.material.card.MaterialCardView>


                    <!-- FINAL LINE -->

                    <View
                        android:layout_width="2dp"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:background="#D9C9FA" />


                    <!-- FINAL DOT -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        app:cardBackgroundColor="#BDA2F5"
                        app:cardCornerRadius="4dp"
                        app:cardElevation="0dp" />

                </LinearLayout>


                <!-- DATA PROTECTION CONTENT -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:text="Data Protection"
                        android:textColor="#21115D"
                        android:textSize="16sp" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="HavenApp uses authenticated account access and access controls to help limit access to sensitive information. Access to report and user information is intended for authorized users and personnel according to their role in the system."
                        android:textColor="#625C82"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ===================================================== -->
    <!-- FLOATING / MOVABLE HOPE -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/cardHopeAssistant"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:background="@null"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Open Hope Assistant"
        android:elevation="12dp"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chatbot"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>