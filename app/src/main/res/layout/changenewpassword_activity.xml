<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"


    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/plain_bg">


    <!-- IMAGE -->

    <ImageView

        android:id="@+id/imgChangePassword"

        android:layout_width="@dimen/auth_image_size"

        android:layout_height="@dimen/auth_image_size"

        android:scaleType="fitCenter"

        android:src="@drawable/forgot_password"


        app:layout_constraintTop_toTopOf="parent"

        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintVertical_bias="0.22"/>



    <!-- TITLE -->

    <TextView

        android:id="@+id/txtTitle"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"


        android:layout_marginTop="12dp"


        android:fontFamily="@font/poppins_bold"

        android:text="Change Your Password"

        android:textColor="@android:color/black"

        android:textSize="@dimen/title_text_size"


        app:layout_constraintTop_toBottomOf="@id/imgChangePassword"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"/>




    <!-- SUBTITLE -->


    <TextView

        android:id="@+id/txtSubtitle"

        android:layout_width="0dp"

        android:layout_height="wrap_content"


        android:layout_marginTop="8dp"

        android:layout_marginStart="@dimen/container_padding"

        android:layout_marginEnd="@dimen/container_padding"


        android:fontFamily="@font/poppins_regular"


        android:gravity="center"


        android:text="Your account was created with a temporary password. Update it now to keep your account secure."


        android:textAlignment="center"


        android:textColor="#666666"


        android:textSize="@dimen/subtitle_text_size"


        app:layout_constraintTop_toBottomOf="@id/txtTitle"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"/>





    <!-- CHANGE PASSWORD BUTTON -->


    <com.google.android.material.button.MaterialButton

        android:id="@+id/btnChangePassword"


        android:layout_width="0dp"

        android:layout_height="@dimen/button_height"


        android:layout_marginTop="28dp"


        android:layout_marginStart="@dimen/container_padding"

        android:layout_marginEnd="@dimen/container_padding"


        android:fontFamily="@font/poppins_bold"


        android:text="Change Password"


        android:textAllCaps="false"


        android:textColor="@android:color/white"


        android:textSize="@dimen/button_text_size"


        app:backgroundTint="@color/violet"


        app:cornerRadius="@dimen/corner_radius"


        app:layout_constraintTop_toBottomOf="@id/txtSubtitle"


        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"/>





    <!-- SKIP BUTTON -->


    <com.google.android.material.button.MaterialButton

        android:id="@+id/btnSkip"


        android:layout_width="0dp"


        android:layout_height="@dimen/button_height"


        android:layout_marginTop="12dp"


        android:layout_marginStart="@dimen/container_padding"

        android:layout_marginEnd="@dimen/container_padding"


        android:fontFamily="@font/poppins_bold"


        android:text="Skip for now"


        android:textAllCaps="false"


        android:textColor="@color/violet"


        android:textSize="@dimen/button_text_size"


        app:backgroundTint="@android:color/transparent"


        app:strokeColor="@color/violet"


        app:strokeWidth="1dp"


        app:cornerRadius="@dimen/corner_radius"


        app:layout_constraintTop_toBottomOf="@id/btnChangePassword"


        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"/>




</androidx.constraintlayout.widget.ConstraintLayout>