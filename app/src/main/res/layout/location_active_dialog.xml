<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:backgroundTint="@android:color/white"

    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">


    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:gravity="center_horizontal"

        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">


        <!-- =============================== -->
        <!-- LOCATION ILLUSTRATION -->
        <!-- =============================== -->

        <ImageView
            android:id="@+id/activeLocationDialogImage"

            android:layout_width="155dp"
            android:layout_height="155dp"

            android:layout_marginTop="2dp"

            android:scaleType="fitCenter"

            android:src="@drawable/location_button"

            android:contentDescription="Location sharing active" />


        <!-- =============================== -->
        <!-- TITLE -->
        <!-- =============================== -->

        <TextView
            android:id="@+id/activeLocationDialogTitle"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:text="Location Sharing Active"

            android:fontFamily="@font/poppins_bold"

            android:textColor="#482080"

            android:textSize="19sp"

            android:textStyle="bold"

            android:gravity="center" />


        <!-- =============================== -->
        <!-- DESCRIPTION -->
        <!-- =============================== -->

        <TextView
            android:id="@+id/activeLocationDialogDescription"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:gravity="center"

            android:text="Your current location is currently shared with HavenApp. You can stop sharing your location at any time."

            android:fontFamily="@font/poppins_regular"

            android:textColor="#666666"

            android:textSize="10sp"

            android:lineSpacingExtra="1dp" />


        <!-- =============================== -->
        <!-- KEEP SHARING -->
        <!-- =============================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keepSharingButton"

            android:layout_width="match_parent"
            android:layout_height="45dp"

            android:layout_marginTop="14dp"

            android:text="KEEP SHARING"

            android:textColor="@android:color/white"

            android:textSize="11sp"

            android:textStyle="bold"

            android:fontFamily="@font/poppins_bold"

            app:backgroundTint="#4a2297"

            app:cornerRadius="22dp"

            app:elevation="0dp" />


        <!-- =============================== -->
        <!-- UNSHARE LOCATION -->
        <!-- =============================== -->

        <TextView
            android:id="@+id/unshareLocationButton"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="7dp"

            android:padding="5dp"

            android:text="UNSHARE LOCATION"

            android:fontFamily="@font/poppins_semibold"

            android:textColor="#888888"

            android:textSize="9sp"

            android:textStyle="bold"

            android:gravity="center"

            android:clickable="true"

            android:focusable="true" />

    </LinearLayout>

</androidx.cardview.widget.CardView>