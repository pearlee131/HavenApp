<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F6FF">


    <!-- ===================================================== -->
    <!-- HOPE HEADER -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hopeHeader"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="18dp"
        app:cardBackgroundColor="#6C2BD9"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <!-- HOPE AVATAR -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHopeAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/imgHopeHeader"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:contentDescription="Hope"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chatbot" />

            </com.google.android.material.card.MaterialCardView>


            <!-- HOPE NAME -->

            <TextView
                android:id="@+id/txtHopeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Hope"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:layout_constraintBottom_toTopOf="@id/txtHopeSubtitle"
                app:layout_constraintStart_toEndOf="@id/cardHopeAvatar"
                app:layout_constraintTop_toTopOf="@id/cardHopeAvatar"
                app:layout_constraintVertical_chainStyle="packed" />


            <!-- SUBTITLE -->

            <TextView
                android:id="@+id/txtHopeSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="Your Haven Assistant"
                android:textColor="#E9DFFF"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="@id/cardHopeAvatar"
                app:layout_constraintStart_toStartOf="@id/txtHopeTitle"
                app:layout_constraintTop_toBottomOf="@id/txtHopeTitle" />


            <!-- MENU -->

            <ImageButton
                android:id="@+id/btnHopeMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Hope menu"
                android:padding="9dp"
                android:src="@drawable/ic_menu"
                app:tint="#FFFFFF"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ===================================================== -->
    <!-- CHAT CONTENT -->
    <!-- ===================================================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerHopeMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toTopOf="@id/layoutHopeInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hopeHeader" />


    <!-- ===================================================== -->
    <!-- INPUT AREA -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutHopeInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <!-- MESSAGE INPUT -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHopeInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="22dp"
            app:cardElevation="1dp"
            app:strokeColor="#E6DFF3"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/edtHopeMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="46dp"
                android:maxHeight="110dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center_vertical"
                android:hint="Ask Hope..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="1000"
                android:maxLines="4"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:textColor="#17113F"
                android:textColorHint="#938BA5"
                android:textSize="13sp" />

        </com.google.android.material.card.MaterialCardView>


        <!-- SEND BUTTON -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHopeSend"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            app:cardBackgroundColor="#6C2BD9"
            app:cardCornerRadius="23dp"
            app:cardElevation="2dp">

            <ImageButton
                android:id="@+id/btnHopeSend"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Send message"
                android:padding="12dp"
                android:src="@drawable/ic_send"
                 />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>