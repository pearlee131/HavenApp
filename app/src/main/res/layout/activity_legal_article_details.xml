<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F6FF">


    <!-- ================================================= -->
    <!-- PURPLE ROUNDED HEADER -->
    <!-- SAME STYLE AS EDUCATIONAL ARTICLES -->
    <!-- ================================================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/articleDetailsHeader"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="18dp"
        app:cardBackgroundColor="#4a2297"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="18dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/txtHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:text="Legal Rights"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/txtArticleHeaderSubtitle"
                app:layout_constraintEnd_toStartOf="@id/btnBack"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/txtArticleHeaderSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Know your rights. Stay informed."
                android:textColor="#E9DFFF"
                android:textSize="10sp"
                app:layout_constraintStart_toStartOf="@id/txtHeaderTitle"
                app:layout_constraintTop_toBottomOf="@id/txtHeaderTitle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnBack" />

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Close"
                android:src="@drawable/exit_ic"
                app:tint="#FFFFFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ================================================= -->
    <!-- LOADING -->
    <!-- ================================================= -->

    <ProgressBar
        android:id="@+id/progressArticleDetails"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:indeterminateTint="#6C2BD9"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/articleDetailsHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ================================================= -->
    <!-- ARTICLE CONTENT -->
    <!-- ================================================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/articleDetailsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/articleDetailsHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/support_horizontal_padding"
            android:paddingTop="18dp"
            android:paddingEnd="@dimen/support_horizontal_padding"
            android:paddingBottom="32dp">


            <!-- ========================================= -->
            <!-- CATEGORY -->
            <!-- ========================================= -->

            <TextView
                android:id="@+id/txtArticleCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_legal_category_chip"
                android:fontFamily="@font/poppins_semibold"
                android:includeFontPadding="false"
                android:paddingStart="11dp"
                android:paddingTop="5dp"
                android:paddingEnd="11dp"
                android:paddingBottom="5dp"
                android:text="LEGAL RIGHTS"
                android:textColor="#6C2BD9"
                android:textSize="9sp" />


            <!-- ========================================= -->
            <!-- TITLE -->
            <!-- ========================================= -->

            <TextView
                android:id="@+id/txtArticleTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:text="What is RA 9262?"
                android:textColor="#17113F"
                android:textSize="23sp"
                android:textStyle="bold" />


            <!-- ========================================= -->
            <!-- SUBTITLE -->
            <!-- ========================================= -->

            <TextView
                android:id="@+id/txtArticleSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:text="Understanding the Anti-Violence Against Women and Their Children Act of 2004"
                android:textColor="#625775"
                android:textSize="12sp" />


            <!-- ========================================= -->
            <!-- SOURCE -->
            <!-- ========================================= -->

            <TextView
                android:id="@+id/txtArticleSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:fontFamily="@font/poppins_medium"
                android:includeFontPadding="false"
                android:text="Philippine Commission on Women"
                android:textColor="#6C2BD9"
                android:textSize="10sp" />


            <!-- ========================================= -->
            <!-- DIVIDER -->
            <!-- ========================================= -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="17dp"
                android:background="#E5DDED" />


            <!-- ========================================= -->
            <!-- ARTICLE BODY -->
            <!-- ========================================= -->

            <TextView
                android:id="@+id/txtArticleContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:lineSpacingExtra="5dp"
                android:text="Article information will appear here."
                android:textColor="#40364E"
                android:textIsSelectable="true"
                android:textSize="12sp" />


            <!-- ========================================= -->
            <!-- OFFICIAL SOURCE CARD -->
            <!-- ========================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardOfficialSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="#EEE6FA"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">


                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_legal_info_circle"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:text="i"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:includeFontPadding="false"
                            android:text="View Official Source"
                            android:textColor="#32118F"
                            android:textSize="12sp" />


                        <TextView
                            android:id="@+id/txtOfficialSourceName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppins_regular"
                            android:includeFontPadding="false"
                            android:text="Philippine Commission on Women"
                            android:textColor="#625775"
                            android:textSize="9sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ================================================= -->
    <!-- ERROR / EMPTY STATE -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/layoutArticleError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/articleDetailsHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="Article unavailable"
            android:textColor="#32118F"
            android:textSize="15sp" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:text="We couldn't load this Legal Rights article right now."
            android:textColor="#766D87"
            android:textSize="11sp" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>