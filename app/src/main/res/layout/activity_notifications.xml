<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F6FF">


    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/notificationsHeader"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="18dp"
        app:cardBackgroundColor="#4a2297"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <!-- TITLE -->

            <TextView
                android:id="@+id/txtNotificationsHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Notifications"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@id/txtNotificationsHeaderSubtitle"
                app:layout_constraintEnd_toStartOf="@id/btnNotificationsBack"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />


            <!-- SUBTITLE -->

            <TextView
                android:id="@+id/txtNotificationsHeaderSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Stay updated on your report progress."
                android:textColor="#E9DFFF"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnNotificationsBack"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtNotificationsHeaderTitle" />


            <!-- BACK / EXIT -->

            <ImageView
                android:id="@+id/btnNotificationsBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/exit_ic"
                app:tint="#FFFFFF"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ===================================================== -->
    <!-- SECTION TITLE -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtNotificationsSectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="22dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Report Updates"
        android:textColor="#17113F"
        android:textSize="17sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/notificationsHeader" />


    <!-- ===================================================== -->
    <!-- MARK ALL AS READ -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtMarkAllAsRead"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="22dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Mark all as read"
        android:textColor="#6C2BD9"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@id/txtNotificationsSectionTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtNotificationsSectionTitle" />


    <!-- ===================================================== -->
    <!-- LOADING -->
    <!-- ===================================================== -->

    <ProgressBar
        android:id="@+id/progressNotifications"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtNotificationsSectionTitle" />


    <!-- ===================================================== -->
    <!-- NOTIFICATIONS LIST -->
    <!-- ===================================================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerNotifications"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtNotificationsSectionTitle" />


    <!-- ===================================================== -->
    <!-- EMPTY STATE -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutNotificationsEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginEnd="35dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="30dp"
        android:paddingBottom="30dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtNotificationsSectionTitle">


        <ImageView
            android:id="@+id/imgNotificationsEmpty"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:alpha="0.55"
            android:contentDescription="No notifications"
            android:src="@drawable/ic_notification" />


        <TextView
            android:id="@+id/txtNotificationsEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="No report updates yet"
            android:textColor="#17113F"
            android:textSize="15sp" />


        <TextView
            android:id="@+id/txtNotificationsEmptyMessage"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Updates about the progress of your submitted reports will appear here."
            android:textColor="#777184"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- FLOATING HOPE ASSISTANT -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/cardHopeAssistant"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:background="@null"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Open Hope Assistant"
        android:elevation="12dp"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chatbot"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>