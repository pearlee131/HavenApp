<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="#EEE9F3"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- COLLAPSED / CLICKABLE HEADER -->
        <LinearLayout
            android:id="@+id/layoutHotlineHeader"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <!-- SAME IDEA AS EDUCATIONAL ARTICLE THUMBNAIL:
                 real hotline icon instead of plain violet box -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="62dp"
                android:layout_height="62dp"
                app:cardBackgroundColor="#D5F1E3"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/imgHotlineIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="5dp"
                    android:contentDescription="Emergency hotline"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_hotlines" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txtHotlineName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:text="MDRRMO – San Enrique"
                android:textColor="#21115D"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/imgExpandHotline"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="6dp"
                android:contentDescription="Expand hotline"
                android:src="@drawable/ic_expand_more"
                app:tint="#6C2BD9" />

        </LinearLayout>

        <!-- PHONE NUMBERS APPEAR WHEN EXPANDED -->
        <LinearLayout
            android:id="@+id/layoutHotlineNumbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="94dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
