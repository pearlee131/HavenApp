<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardEmergencyHotline"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="#EEE8F8"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- ========================= -->
        <!-- COLLAPSED / HEADER AREA -->
        <!-- ========================= -->

        <LinearLayout
            android:id="@+id/layoutHotlineHeader"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="14dp">


            <!-- HOTLINE ICON -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardBackgroundColor="#F1EAFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/imgHotlineIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="11dp"
                    android:contentDescription="Hotline"
                    android:src="@drawable/ic_hotlines"
                    app:tint="#6C2BD9" />

            </com.google.android.material.card.MaterialCardView>


            <!-- NAME -->

            <TextView
                android:id="@+id/txtHotlineName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp"
                android:text="MDRRMO – San Enrique"
                android:textColor="#32118F"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="2" />


            <!-- DROPDOWN ARROW -->

            <ImageView
                android:id="@+id/imgExpandHotline"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="7dp"
                android:contentDescription="Expand hotline"
                android:src="@drawable/ic_arrow_down"
                app:tint="#6C2BD9" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- EXPANDED NUMBER AREA -->
        <!-- Hidden by default -->
        <!-- ========================= -->

        <LinearLayout
            android:id="@+id/layoutHotlineNumbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="74dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <!--
                Number rows will be added here dynamically
                by EmergencyHotlineAdapter.java.

                Example:

                0963 988 3134     [copy icon]

                This allows one hotline to contain either
                one number or multiple numbers.
            -->

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>