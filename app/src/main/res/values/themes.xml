<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Base.Theme.HavenApp" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Android 12+ System Splash Screen -->
        <item name="android:windowSplashScreenBackground">@color/white</item>

        <!-- Remove the small default logo/icon -->
        <item name="android:windowSplashScreenAnimatedIcon">@null</item>

        <!-- Prevent default splash branding -->
        <item name="android:windowSplashScreenIconBackgroundColor">@color/white</item>

    </style>

    <style name="Theme.HavenApp" parent="Base.Theme.HavenApp" />

    <!-- Circular Profile Image -->
    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>